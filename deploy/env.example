# ==========================================
# SWIVIQ backend — environnement PRODUCTION
# Copié sur le VPS : /var/www/swiviq/backend/.env
# ==========================================

# Server
PORT=4001

# MySQL production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=swiviq_prod
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

# Auth
JWT_SECRET=CHANGE_ME
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# AI chatbot (optional — rule-based fallback used when AI_API_KEY is empty)
AI_API_KEY=CHANGE_ME
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGIN=CHANGE_ME
