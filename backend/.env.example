# Server
PORT=4000

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=swiviq_dev
DB_USER=root
DB_PASS=

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-byte-hex-string
ADMIN_EMAIL=admin@swiviq.com
ADMIN_PASSWORD=CHANGE_ME

# AI chatbot (optional — rule-based fallback used when AI_API_KEY is empty)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGIN=http://localhost:4200
